<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>免費 WhatsApp 連結生成器</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Microsoft JhengHei', 'PingFang TC', Arial, sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, #25D366, #128C7E);
            min-height: 100vh;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        
        .container {
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            width: 100%;
            max-width: 500px;
            text-align: center;
        }
        
        .logo {
            font-size: 48px;
            margin-bottom: 15px;
        }
        
        h1 {
            color: #128C7E;
            margin-bottom: 10px;
            font-size: 24px;
        }
        
        .subtitle {
            color: #666;
            margin-bottom: 30px;
            font-size: 14px;
        }
        
        .input-group {
            margin-bottom: 20px;
            text-align: left;
        }
        
        label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-weight: bold;
        }
        
        input, textarea {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #ddd;
            border-radius: 10px;
            font-size: 16px;
            transition: border-color 0.3s;
        }
        
        input:focus, textarea:focus {
            outline: none;
            border-color: #25D366;
        }
        
        textarea {
            height: 100px;
            resize: vertical;
            font-family: inherit;
        }
        
        .generate-btn {
            background: linear-gradient(135deg, #25D366, #128C7E);
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 10px;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
            transition: transform 0.2s;
            margin-bottom: 10px;
        }
        
        .generate-btn:hover {
            transform: translateY(-2px);
        }

        .generate-btn:disabled {
            background: #cccccc;
            cursor: not-allowed;
            transform: none;
        }
        
        .result {
            margin-top: 25px;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 10px;
            border-left: 4px solid #25D366;
            text-align: left;
            display: none;
        }
        
        .short-link {
            color: #128C7E;
            font-weight: bold;
            word-break: break-all;
            margin: 10px 0;
            font-size: 18px;
            padding: 10px;
            background: white;
            border-radius: 5px;
            border: 1px solid #ddd;
        }
        
        .copy-btn {
            background: #25D366;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 10px;
            font-size: 16px;
            width: 100%;
        }

        .copy-btn:hover {
            background: #128C7E;
        }
        
        .features {
            display: flex;
            justify-content: space-around;
            margin-top: 20px;
            color: #666;
            font-size: 14px;
        }
        
        .feature-item {
            text-align: center;
        }
        
        .feature-icon {
            font-size: 20px;
            margin-bottom: 5px;
        }

        .loading {
            color: #128C7E;
            font-style: italic;
        }

        .error {
            color: #ff4444;
            font-size: 14px;
            margin-top: 10px;
        }

        .success {
            color: #25D366;
            font-size: 14px;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo">📱</div>
        <h1>免費 WhatsApp 連結生成器</h1>
        <p class="subtitle">輸入號碼和訊息，一鍵生成真正短連結</p>
        
        <div class="input-group">
            <label for="phone">電話號碼（含國碼）</label>
            <input type="text" id="phone" placeholder="例如：85291234567" value="852">
        </div>
        
        <div class="input-group">
            <label for="message">預設訊息（支援中英文和 Emoji）</label>
            <textarea id="message" placeholder="例如：你好！👋 我想查詢更多資料...">你好！👋 我想查詢更多資料...</textarea>
        </div>
        
        <button class="generate-btn" id="generateBtn" onclick="generateLink()">🎯 生成 WhatsApp 短連結</button>
        <div class="subtitle">自動生成真正短連結（約 25-30 個字符）</div>
        
        <div class="result" id="result">
            <strong>✅ 您的短連結已生成：</strong>
            <div class="short-link" id="shortLink"></div>
            <button class="copy-btn" onclick="copyToClipboard()">📋 複製短連結</button>
            <div style="margin-top: 10px; font-size: 12px; color: #666;">
                <strong>原始連結預覽：</strong> <span id="linkPreview"></span>
            </div>
            <div id="statusMessage"></div>
        </div>
        
        <div class="features">
            <div class="feature-item">
                <div class="feature-icon">💰</div>
                <div>完全免費</div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">🔗</div>
                <div>真正短連結</div>
            </div>
            <div class="feature-item">
                <div class="feature-icon">📱</div>
                <div>手機可用</div>
            </div>
        </div>
    </div>

    <script>
        async function generateLink() {
            const phone = document.getElementById('phone').value.trim();
            const message = document.getElementById('message').value.trim();
            const generateBtn = document.getElementById('generateBtn');
            const statusMessage = document.getElementById('statusMessage');
            
            if (!phone) {
                alert('請輸入電話號碼');
                return;
            }
            
            if (!message) {
                alert('請輸入訊息內容');
                return;
            }
            
            // 禁用按鈕防止重複點擊
            generateBtn.disabled = true;
            generateBtn.textContent = '⏳ 生成中...';
            statusMessage.innerHTML = '<div class="loading">正在生成短連結，請稍候...</div>';
            
            // 顯示結果區域
            document.getElementById('result').style.display = 'block';
            document.getElementById('shortLink').textContent = '生成中...';
            
            try {
                // 編碼訊息
                const encodedMessage = encodeURIComponent(message);
                
                // 生成 WhatsApp 連結
                const whatsappLink = `https://wa.me/${phone}?text=${encodedMessage}`;
                document.getElementById('linkPreview').textContent = whatsappLink;
                
                // 使用免費短網址服務生成真正短連結
                const shortLink = await shortenUrl(whatsappLink);
                
                // 顯示真正的短連結
                document.getElementById('shortLink').textContent = shortLink;
                
                // 儲存連結用於複製
                window.currentLink = shortLink;
                
                statusMessage.innerHTML = '<div class="success">✅ 短連結生成成功！</div>';
                
            } catch (error) {
                console.error('Error:', error);
                // 如果短網址服務失敗，使用原始連結
                const encodedMessage = encodeURIComponent(message);
                const whatsappLink = `https://wa.me/${phone}?text=${encodedMessage}`;
                document.getElementById('shortLink').textContent = whatsappLink;
                document.getElementById('linkPreview').textContent = '短網址服務暫時不可用，這是原始連結';
                window.currentLink = whatsappLink;
                
                statusMessage.innerHTML = '<div class="error">⚠️ 短連結服務繁忙，已顯示原始連結</div>';
            } finally {
                // 重新啟用按鈕
                generateBtn.disabled = false;
                generateBtn.textContent = '🎯 生成 WhatsApp 短連結';
            }
        }
        
        // 使用直接跳轉的短網址服務（無廣告）
async function shortenUrl(longUrl) {
    try {
        // 方法1: 使用 is.gd（無廣告，直接跳轉）
        const isgdResponse = await fetch(`https://is.gd/create.php?format=simple&url=${encodeURIComponent(longUrl)}`);
        if (isgdResponse.ok) {
            const shortUrl = await isgdResponse.text();
            if (shortUrl && shortUrl.startsWith('http')) {
                return shortUrl;
            }
        }
    } catch (error) {
        console.log('is.gd failed, trying v.gd...');
    }
    
    try {
        // 方法2: 使用 v.gd（同 is.gd，備用）
        const vgdResponse = await fetch(`https://v.gd/create.php?format=simple&url=${encodeURIComponent(longUrl)}`);
        if (vgdResponse.ok) {
            const shortUrl = await vgdResponse.text();
            if (shortUrl && shortUrl.startsWith('http')) {
                return shortUrl;
            }
        }
    } catch (error) {
        console.log('v.gd failed, trying other services...');
    }
    
    try {
        // 方法3: 使用 tinyurl（最後備用）
        const tinyUrlResponse = await fetch(`https://tinyurl.com/api-create.php?url=${encodeURIComponent(longUrl)}`);
        if (tinyUrlResponse.ok) {
            const shortUrl = await tinyUrlResponse.text();
            if (shortUrl && shortUrl.startsWith('http')) {
                return shortUrl;
            }
        }
    } catch (error) {
        console.log('All direct URL shortening services failed');
    }
    
    // 所有服務都失敗，使用原始連結
    throw new Error('All URL shortening services failed');
}
   
        function copyToClipboard() {
            const link = window.currentLink;
            if (!link) {
                alert('請先生成連結');
                return;
            }
            
            navigator.clipboard.writeText(link).then(() => {
                alert('✅ 短連結已複製到剪貼簿！');
            }).catch(() => {
                // 降級方案
                const tempInput = document.createElement('input');
                tempInput.value = link;
                document.body.appendChild(tempInput);
                tempInput.select();
                document.execCommand('copy');
                document.body.removeChild(tempInput);
                alert('✅ 短連結已複製到剪貼簿！');
            });
        }
        
        // 按 Enter 鍵也可生成
        document.getElementById('message').addEventListener('keypress', function(e) {
            if (e.key === 'Enter' && e.ctrlKey) {
                generateLink();
            }
        });

        // 初始化顯示
        document.getElementById('result').style.display = 'none';
    </script>
</body>
</html>
